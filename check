#!/usr/bin/env bash
# check_network_drill.sh
# Read-only network recovery checker. Run with: sudo ./check_network_drill.sh

set +e

RED='\033[1;31m'
GREEN='\033[1;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

pass=0
fail=0
warn=0

check() {
    local name="$1"
    local result="$2"

    if [[ "$result" == "PASS" ]]; then
        echo -e "${GREEN}[PASS]${NC} $name"
        ((pass++))
    elif [[ "$result" == "WARN" ]]; then
        echo -e "${YELLOW}[WARN]${NC} $name"
        ((warn++))
    else
        echo -e "${RED}[FAIL]${NC} $name"
        ((fail++))
    fi
}

echo "=============================================================="
echo " Network Blackout Recovery Checker"
echo "=============================================================="
echo

# ------------------------------------------------------------------
# 1. Interfaces
# ------------------------------------------------------------------
active_ifaces=$(ip -br link | awk '$1 != "lo" && $2 ~ /UP/ {print $1}')

if [[ -n "$active_ifaces" ]]; then
    check "At least one non-loopback interface is UP" PASS
else
    check "At least one non-loopback interface is UP" FAIL
fi

echo "  Active interfaces: ${active_ifaces:-NONE}"
echo

# ------------------------------------------------------------------
# 2. Loopback
# ------------------------------------------------------------------
lo_state=$(ip -br link show lo 2>/dev/null | awk '{print $2}')
lo_mtu=$(ip link show lo 2>/dev/null | awk '/^[0-9]+: lo:/{for(i=1;i<=NF;i++) if($i=="mtu") print $(i+1)}')

[[ "$lo_state" == "UP" ]] \
    && check "Loopback interface is UP" PASS \
    || check "Loopback interface is UP" FAIL

if [[ "$lo_mtu" =~ ^[0-9]+$ && "$lo_mtu" -ge 576 ]]; then
    check "Loopback MTU restored ($lo_mtu)" PASS
else
    check "Loopback MTU restored (currently ${lo_mtu:-unknown})" FAIL
fi

echo

# ------------------------------------------------------------------
# 3. Default route
# ------------------------------------------------------------------
default_route=$(ip route show default 2>/dev/null | head -n 1)

if [[ -n "$default_route" && "$default_route" != *"blackhole"* ]]; then
    check "Normal default route exists" PASS
    echo "  $default_route"
else
    check "Normal default route exists" FAIL
    echo "  Current: ${default_route:-NONE}"
fi

echo

# ------------------------------------------------------------------
# 4. Blackhole default route
# ------------------------------------------------------------------
if ip route show 2>/dev/null | grep -q '^blackhole default'; then
    check "Blackhole default route removed" FAIL
else
    check "Blackhole default route removed" PASS
fi

# ------------------------------------------------------------------
# 5. Loopback blackhole
# ------------------------------------------------------------------
if ip route show 2>/dev/null | grep -q '^blackhole 127\.0\.0\.0/8'; then
    check "Loopback blackhole route removed" FAIL
else
    check "Loopback blackhole route removed" PASS
fi

echo

# ------------------------------------------------------------------
# 6. ARP / neighbor state
# ------------------------------------------------------------------
neigh_count=$(ip neigh show 2>/dev/null | grep -v '^$' | wc -l)

if (( neigh_count > 0 )); then
    check "Neighbor/ARP entries present" PASS
else
    check "Neighbor/ARP entries present" WARN
fi

echo "  Neighbor entries: $neigh_count"
echo

# ------------------------------------------------------------------
# 7. ARP enabled
# ------------------------------------------------------------------
arp_disabled=0

while read -r iface; do
    [[ -z "$iface" ]] && continue

    if ip link show "$iface" 2>/dev/null | grep -q "NOARP"; then
        echo "  NOARP: $iface"
        arp_disabled=1
    fi
done < <(ip -br link | awk '$1 != "lo" {print $1}')

if (( arp_disabled == 0 )); then
    check "ARP is enabled on interfaces" PASS
else
    check "ARP is enabled on interfaces" FAIL
fi

echo

# ------------------------------------------------------------------
# 8. iptables policies
# ------------------------------------------------------------------
if command -v iptables >/dev/null 2>&1; then
    input=$(iptables -S INPUT 2>/dev/null | head -n1)
    output=$(iptables -S OUTPUT 2>/dev/null | head -n1)
    forward=$(iptables -S FORWARD 2>/dev/null | head -n1)

    if [[ "$input" != "-P INPUT DROP" &&
          "$output" != "-P OUTPUT DROP" &&
          "$forward" != "-P FORWARD DROP" ]]; then
        check "iptables default DROP policies removed" PASS
    else
        check "iptables default DROP policies removed" FAIL
        echo "  INPUT:   $input"
        echo "  OUTPUT:  $output"
        echo "  FORWARD: $forward"
    fi
else
    check "iptables available for inspection" WARN
fi

echo

# ------------------------------------------------------------------
# 9. Resolver
# ------------------------------------------------------------------
if [[ -e /etc/resolv.conf ]]; then
    if grep -q '192\.0\.2\.1' /etc/resolv.conf; then
        check "Dummy nameserver removed from resolv.conf" FAIL
    elif grep -Eq '^[[:space:]]*nameserver[[:space:]]+' /etc/resolv.conf; then
        check "Resolver configuration contains nameserver" PASS
    else
        check "Resolver configuration contains nameserver" FAIL
    fi
else
    check "/etc/resolv.conf exists" FAIL
fi

echo

# ------------------------------------------------------------------
# 10. Network services
# ------------------------------------------------------------------
for svc in NetworkManager systemd-resolved networking; do
    if systemctl list-unit-files "$svc.service" >/dev/null 2>&1; then
        state=$(systemctl is-active "$svc" 2>/dev/null)

        if [[ "$state" == "active" ]]; then
            check "$svc is active" PASS
        else
            check "$svc is active" WARN
            echo "  Current state: $state"
        fi
    fi
done

echo

# ------------------------------------------------------------------
# 11. Connectivity tests
# ------------------------------------------------------------------
if ping -c 1 -W 2 127.0.0.1 >/dev/null 2>&1; then
    check "Loopback connectivity" PASS
else
    check "Loopback connectivity" FAIL
fi

if ping -c 1 -W 2 1.1.1.1 >/dev/null 2>&1; then
    check "Internet connectivity by IP" PASS
else
    check "Internet connectivity by IP" FAIL
fi

if getent hosts example.com >/dev/null 2>&1; then
    check "DNS resolution" PASS
else
    check "DNS resolution" FAIL
fi

echo
echo "=============================================================="
echo " Results: ${GREEN}${pass} PASS${NC}, ${YELLOW}${warn} WARN${NC}, ${RED}${fail} FAIL${NC}"
echo "=============================================================="

if (( fail == 0 )); then
    echo -e "${GREEN}Network appears to be recovered.${NC}"
else
    echo -e "${RED}Network recovery is incomplete.${NC}"
fi
